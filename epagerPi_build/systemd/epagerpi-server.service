[Unit]
Description=epagerPi 排版編輯器 / API（Pi 本機模式，不驗證）
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/epagerPi
Environment=PYTHONPATH=/home/pi/epagerPi
Environment=EPAGERPI_AUTH_ENABLED=0
ExecStart=/usr/bin/python3 -m server.app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
